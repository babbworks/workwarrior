#!/usr/bin/env bats
# test-ledger-attention.bats — TASK-LED-017
#
# Tests for `ww ledger attention`: the attention queue.
# Verifies:
#   - V1: weighted sum matches hand-calculation
#   - V2: time-varying coefficients reorder the queue
#   - Two-profile fixture: same records, different weights, different ranking
#   - --format json produces valid JSON
#   - --top N truncates
#   - --at DATE for counterfactual
#   - --filter for account filtering
#   - --show-weights shows weights column
#   - --weights-file generates inspectable P directives

load 'test_helper/bats-support/load'
load 'test_helper/bats-assert/load'

setup() {
  export WW_BASE="${BATS_TEST_TMPDIR}/ww-instance"
  export WORKWARRIOR_BASE="${BATS_TEST_TMPDIR}/ww-profile-alpha"
  export WARRIOR_PROFILE="alpha"

  mkdir -p "$WW_BASE/config"
  mkdir -p "$WW_BASE/services/stream"
  mkdir -p "$WW_BASE/profiles/alpha/ledgers/derived"
  mkdir -p "$WW_BASE/profiles/bravo/ledgers/derived"

  # Symlink profile for WORKWARRIOR_BASE
  ln -sf "$WW_BASE/profiles/alpha" "$WORKWARRIOR_BASE" 2>/dev/null || \
    WORKWARRIOR_BASE="$WW_BASE/profiles/alpha"

  # Copy the real attention.py
  local repo_root="${BATS_TEST_DIRNAME}/../.."
  cp "${repo_root}/services/stream/attention.py" "$WW_BASE/services/stream/"

  # Create instance actors.yaml
  cat > "$WW_BASE/config/actors.yaml" <<'EOF'
schema: v1
id_scheme: solo
actors:
  human:op-01:
    kind: human
    display: "Operator One"
    status: active
    source: local
  human:op-02:
    kind: human
    display: "Operator Two"
    status: active
    source: local
  machine:lathe-01:
    kind: machine
    display: "CNC Lathe"
    status: active
    source: local
  agent:claude-07:
    kind: agent
    display: "Claude Seven"
    status: active
    source: local
EOF

  # Create profile ALPHA — actors weighted differently
  mkdir -p "$WW_BASE/profiles/alpha"
  cat > "$WW_BASE/profiles/alpha/actors.yaml" <<'EOF'
schema: v1
members:
  human:op-01:
    role: operator
    weight: 1.0
  human:op-02:
    role: operator
    weight: 2.0
  machine:lathe-01:
    role: asset
    weight: 3.0
  agent:claude-07:
    role: builder
    weight: 0.5
EOF

  # Create profile BRAVO — different weights (safety mode)
  mkdir -p "$WW_BASE/profiles/bravo"
  cat > "$WW_BASE/profiles/bravo/actors.yaml" <<'EOF'
schema: v1
members:
  human:op-01:
    role: operator
    weight: 2.0
  human:op-02:
    role: operator
    weight: 1.0
  machine:lathe-01:
    role: asset
    weight: 5.0
  agent:claude-07:
    role: builder
    weight: 0.1
EOF

  # Create a derived/stream.journal with known data for hand-verification
  # Operator 1: 4.00 h on project-a
  # Operator 2: 6.00 h on project-b
  # Lathe-01:   2.00 h on project-a (machine running unattended)
  # Claude:     8.00 h on project-c
  cat > "$WW_BASE/profiles/alpha/ledgers/derived/stream.journal" <<'EOF'
; GENERATED by ww ledger sync-stream — DO NOT EDIT
; Source: test fixture
; Generated: 2026-07-15T12:00:00Z

2026-07-14 * punch  Operator One -> proj-a
    ; stream:actor=human:op-01
    time:project:project-a          4.00 h
    actors:human:op-01          -4.00 h

2026-07-14 * punch  Operator Two -> proj-b
    ; stream:actor=human:op-02
    time:project:project-b          6.00 h
    actors:human:op-02          -6.00 h

2026-07-15 * punch  CNC Lathe -> proj-a
    ; stream:actor=machine:lathe-01
    time:project:project-a          2.00 h
    actors:machine:lathe-01          -2.00 h

2026-07-15 * punch  Claude Seven -> proj-c
    ; stream:actor=agent:claude-07
    time:project:project-c          8.00 h
    actors:agent:claude-07          -8.00 h
EOF

  # Copy the same journal to bravo (same records, different weights)
  cp "$WW_BASE/profiles/alpha/ledgers/derived/stream.journal" \
     "$WW_BASE/profiles/bravo/ledgers/derived/stream.journal"

  ATTENTION_SCRIPT="$WW_BASE/services/stream/attention.py"
}

teardown() {
  rm -rf "$BATS_TEST_TMPDIR"
}

# Helper: run attention with standard paths
run_attention() {
  python3 "$ATTENTION_SCRIPT" \
    --ww-base "$WW_BASE" \
    --profile-base "$WW_BASE/profiles/alpha" \
    "$@" 2>/dev/null
}

run_attention_bravo() {
  python3 "$ATTENTION_SCRIPT" \
    --ww-base "$WW_BASE" \
    --profile-base "$WW_BASE/profiles/bravo" \
    "$@" 2>/dev/null
}


# ── Basic functionality ─────────────────────────────────────────────────────

@test "attention produces output with valid journal data" {
  run run_attention
  assert_success
  # Should contain at least one account line
  assert_output --partial "att"
}

@test "attention lists actor accounts" {
  run run_attention
  assert_success
  assert_output --partial "actors:human:op-01"
  assert_output --partial "actors:human:op-02"
  assert_output --partial "actors:machine:lathe-01"
  assert_output --partial "actors:agent:claude-07"
}

@test "attention lists time accounts" {
  run run_attention
  assert_success
  assert_output --partial "time:project:project-a"
  assert_output --partial "time:project:project-b"
  assert_output --partial "time:project:project-c"
}


# ── V1: Weighted sum matches hand-calculation ───────────────────────────────
#
# Alpha weights: op-01=1.0, op-02=2.0, lathe-01=3.0, claude-07=0.5
# Balances (actor accounts, absolute): op-01=4h, op-02=6h, lathe=2h, claude=8h
# Attention: op-01: 4×1.0=4.0, op-02: 6×2.0=12.0, lathe: 2×3.0=6.0, claude: 8×0.5=4.0

@test "V1: weighted sum matches hand-calculation — op-02 = 12.0 att" {
  run run_attention --format json
  assert_success
  # Parse and verify op-02 attention value
  local att
  att=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for entry in data['queue']:
    if entry['account'] == 'actors:human:op-02':
        print(entry['attention'])
        break
")
  [ "$att" = "12.0" ]
}

@test "V1: weighted sum matches hand-calculation — lathe-01 = 6.0 att" {
  run run_attention --format json
  assert_success
  local att
  att=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for entry in data['queue']:
    if entry['account'] == 'actors:machine:lathe-01':
        print(entry['attention'])
        break
")
  [ "$att" = "6.0" ]
}

@test "V1: weighted sum matches hand-calculation — op-01 = 4.0 att" {
  run run_attention --format json
  assert_success
  local att
  att=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for entry in data['queue']:
    if entry['account'] == 'actors:human:op-01':
        print(entry['attention'])
        break
")
  [ "$att" = "4.0" ]
}

@test "V1: weighted sum matches hand-calculation — claude = 4.0 att" {
  run run_attention --format json
  assert_success
  local att
  att=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for entry in data['queue']:
    if entry['account'] == 'actors:agent:claude-07':
        print(entry['attention'])
        break
")
  [ "$att" = "4.0" ]
}


# ── V2: Two-profile fixture — same records, different weights, different ranking ──

@test "V2: alpha profile ranks op-02 highest among actors" {
  run run_attention --format json --filter actors
  assert_success
  local top_actor
  top_actor=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
actors = [e for e in data['queue'] if e['kind'] == 'actor']
if actors:
    print(actors[0]['account'])
")
  [ "$top_actor" = "actors:human:op-02" ]
}

@test "V2: bravo profile ranks lathe-01 highest among actors (safety mode)" {
  # Bravo weights: op-01=2.0, op-02=1.0, lathe=5.0, claude=0.1
  # Attention: op-01: 4×2.0=8.0, op-02: 6×1.0=6.0, lathe: 2×5.0=10.0, claude: 8×0.1=0.8
  run run_attention_bravo --format json --filter actors
  assert_success
  local top_actor
  top_actor=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
actors = [e for e in data['queue'] if e['kind'] == 'actor']
if actors:
    print(actors[0]['account'])
")
  [ "$top_actor" = "actors:machine:lathe-01" ]
}

@test "V2: same records produce different ranking with different weights" {
  # Get alpha ranking
  run run_attention --format json --filter actors
  assert_success
  local alpha_top
  alpha_top=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
actors = [e for e in data['queue'] if e['kind'] == 'actor']
if actors:
    print(actors[0]['account'])
")

  # Get bravo ranking
  run run_attention_bravo --format json --filter actors
  assert_success
  local bravo_top
  bravo_top=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
actors = [e for e in data['queue'] if e['kind'] == 'actor']
if actors:
    print(actors[0]['account'])
")

  # They must differ — that's the whole point: same records, different mode
  [ "$alpha_top" != "$bravo_top" ]
}


# ── --format json ───────────────────────────────────────────────────────────

@test "--format json produces valid JSON" {
  run run_attention --format json
  assert_success
  # Validate JSON parses
  echo "$output" | python3 -c "import json, sys; json.load(sys.stdin)"
}

@test "--format json contains version field" {
  run run_attention --format json
  assert_success
  local ver
  ver=$(echo "$output" | python3 -c "import json, sys; print(json.load(sys.stdin)['version'])")
  [ "$ver" = "1" ]
}

@test "--format json contains coefficients" {
  run run_attention --format json
  assert_success
  local has_coeff
  has_coeff=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
print('yes' if 'coefficients' in data else 'no')
")
  [ "$has_coeff" = "yes" ]
}

@test "--format json coefficients match profile weights" {
  run run_attention --format json
  assert_success
  local op02_weight
  op02_weight=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
print(data['coefficients'].get('human:op-02', 'missing'))
")
  [ "$op02_weight" = "2.0" ]
}


# ── --top N ─────────────────────────────────────────────────────────────────

@test "--top 2 returns only 2 entries" {
  run run_attention --format json --top 2
  assert_success
  local count
  count=$(echo "$output" | python3 -c "import json, sys; print(json.load(sys.stdin)['count'])")
  [ "$count" = "2" ]
}

@test "--top 1 returns the single highest-attention account" {
  run run_attention --format json --top 1
  assert_success
  local count
  count=$(echo "$output" | python3 -c "import json, sys; print(json.load(sys.stdin)['count'])")
  [ "$count" = "1" ]
}


# ── --filter ────────────────────────────────────────────────────────────────

@test "--filter actors shows only actor accounts" {
  run run_attention --format json --filter actors
  assert_success
  local all_actors
  all_actors=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
print('yes' if all('actors:' in e['account'] for e in data['queue']) else 'no')
")
  [ "$all_actors" = "yes" ]
}

@test "--filter time shows only time accounts" {
  run run_attention --format json --filter time
  assert_success
  local all_time
  all_time=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
print('yes' if all('time:' in e['account'] for e in data['queue']) else 'no')
")
  [ "$all_time" = "yes" ]
}

@test "--filter project-a narrows to project-a accounts" {
  run run_attention --format json --filter project-a
  assert_success
  local all_match
  all_match=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
print('yes' if all('project-a' in e['account'] for e in data['queue']) else 'no')
")
  [ "$all_match" = "yes" ]
}


# ── --show-weights ──────────────────────────────────────────────────────────

@test "--show-weights includes WEIGHT header in text output" {
  run run_attention --show-weights
  assert_success
  assert_output --partial "WEIGHT"
}

@test "text output without --show-weights omits weight column" {
  run run_attention
  assert_success
  refute_output --partial "WEIGHT"
}


# ── --weights-file ──────────────────────────────────────────────────────────

@test "--weights-file writes P directives to specified path" {
  local wfile="${BATS_TEST_TMPDIR}/weights.journal"
  run run_attention --weights-file "$wfile"
  assert_success
  [ -f "$wfile" ]
}

@test "weights file contains P directives with correct values" {
  local wfile="${BATS_TEST_TMPDIR}/weights.journal"
  run run_attention --weights-file "$wfile"
  assert_success
  # Check that the weights journal has P directives
  run grep "^P " "$wfile"
  assert_success
  # op-02 weight is 2.0
  run grep "human_op-02_h 2.0 att" "$wfile"
  assert_success
}

@test "weights file documents the coefficient table (traceability — criterion 2)" {
  local wfile="${BATS_TEST_TMPDIR}/weights.journal"
  run run_attention --weights-file "$wfile"
  assert_success
  # Has a header explaining what it is
  run grep "coefficient table" "$wfile"
  assert_success
}


# ── Empty/missing data ──────────────────────────────────────────────────────

@test "no journal data produces empty queue gracefully" {
  rm -f "$WW_BASE/profiles/alpha/ledgers/derived/stream.journal"
  run run_attention --format json
  assert_success
  local count
  count=$(echo "$output" | python3 -c "import json, sys; print(json.load(sys.stdin)['count'])")
  [ "$count" = "0" ]
}

@test "no profile actors.yaml falls back to instance actors at weight 1.0" {
  rm -f "$WW_BASE/profiles/alpha/actors.yaml"
  run run_attention --format json
  assert_success
  # All weights should be 1.0
  local all_one
  all_one=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
actors = [e for e in data['queue'] if e['kind'] == 'actor']
print('yes' if all(e['weight'] == 1.0 for e in actors) else 'no')
")
  [ "$all_one" = "yes" ]
}


# ── Sorted descending ──────────────────────────────────────────────────────

@test "output is sorted by attention value descending" {
  run run_attention --format json
  assert_success
  local sorted_check
  sorted_check=$(echo "$output" | python3 -c "
import json, sys
data = json.load(sys.stdin)
values = [e['attention'] for e in data['queue']]
print('yes' if values == sorted(values, reverse=True) else 'no')
")
  [ "$sorted_check" = "yes" ]
}
